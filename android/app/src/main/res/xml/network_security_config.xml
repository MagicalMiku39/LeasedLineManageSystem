<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. A self-signed server certificate is accepted solely by matching the
     SHA-256 fingerprint the user confirmed in the app (see CertUtil / MainActivity). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
